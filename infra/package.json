{
  "name": "@kin/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "bootstrap": "cdk bootstrap \"aws://$(aws sts get-caller-identity --query Account --output text)/us-east-1\" --app '' --qualifier kin --toolkit-stack-name KinCDKToolkit --termination-protection",
    "deploy": "cdk deploy --all --require-approval broadening"
  },
  "dependencies": {
    "@kin/auth": "workspace:*",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1145.0"
  }
}
