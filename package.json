{
  "name": "kin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "test:e2e:key": "pnpm -r --if-present run test:e2e:key",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:up": "pnpm --filter @kin/db run local:up",
    "db:down": "pnpm --filter @kin/db run local:down",
    "queue:up": "pnpm --filter @kin/paypal run local:queue:up",
    "queue:down": "pnpm --filter @kin/paypal run local:queue:down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
