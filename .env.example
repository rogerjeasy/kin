# Copy to .env (git-ignored) and fill in. Only names live here, never values.

# REST API credentials of one PayPal sandbox app, from developer.paypal.com > Apps & Credentials > Sandbox.
# The app belongs to a sandbox business account, which stands in for a shop.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# The currency the sandbox trials use. It must be one the sandbox business account accepts.
PAYPAL_TRIAL_CURRENCY=
PAYPAL_SANDBOX_MERCHANT_CLIENT_ID=
PAYPAL_SANDBOX_MERCHANT_CLIENT_SECRET=

# Kin's sign-in email (infra/src/sign-in-email.ts). Cognito hands every code
# to Kin's sender, which sends it from this Gmail account.
# Order: fill both, run `pnpm --filter @kin/notify run gmail:test`, then
# `AWS_PROFILE=wick-dev pnpm --filter @kin/infra run gmail:store`, then deploy.
# A deploy reads KIN_SENDER_EMAIL from here and switches email codes on, so
# leave it empty until the app password is stored.
KIN_SENDER_EMAIL=
# The 16-letter app password from myaccount.google.com/apppasswords
# (the Google account needs 2-Step Verification).
KIN_GMAIL_APP_PASSWORD=

# Kin's database (packages/db). For local development, `pnpm db:up` starts
# PostgreSQL in Docker (container kin-postgres) with these settings, and
# `pnpm --filter @kin/db run migrate` creates the schema and the three roles.
# Choose any passwords; they never leave this machine. In AWS, Secrets
# Manager holds them and the migration function reads them from there.
KIN_DATABASE_HOST=
# 54329 locally, so it never collides with another PostgreSQL. 5432 on Aurora.
KIN_DATABASE_PORT=
KIN_DATABASE_NAME=
# "off" only for a database on this machine. Anything else uses verified TLS.
KIN_DATABASE_TLS=
# The user that owns the schema and runs migrations. Nothing else connects as it.
KIN_DATABASE_ADMIN_USER=
KIN_DATABASE_ADMIN_PASSWORD=
# The roles Kin connects as: a signed-in person, Kin's worker, the demo provisioner.
KIN_DATABASE_APP_PASSWORD=
KIN_DATABASE_SERVICE_PASSWORD=
KIN_DATABASE_PROVISIONER_PASSWORD=

# Top-ups (docs/architecture.md section 8.4). The pool's PayPal sandbox app,
# as the web app and the worker read it: usually the same app as
# PAYPAL_SANDBOX_CLIENT_ID above. `pnpm --filter @kin/infra run paypal:store`
# copies the secret into AWS. The client ID is safe to publish.
KIN_PAYPAL_CLIENT_ID=
KIN_PAYPAL_CLIENT_SECRET=
# The worker verifies webhooks against this ID (`webhook:register` prints it).
# No webhook reaches a local machine, so locally any placeholder will do.
KIN_PAYPAL_WEBHOOK_ID=
# The PayPal inbox. `pnpm queue:up` starts a stand-in for SQS on this machine
# and prints these two lines.
KIN_QUEUE_ENDPOINT=
KIN_PAYPAL_INBOX_URL=
# Requests by PayPal invoice in demo circles: a PayPal sandbox personal account
# (…@personal.example.com only) that stands in for the demo's members, so a
# demo request is a real sandbox invoice. Unset, demo invoices are simulated
# and labelled so. Never a visitor's address.
KIN_DEMO_INVOICE_RECIPIENT_EMAIL=
# Real sandbox payouts in demo circles. Unset, every demo payout stays simulated.
# Set to a Kin-owned PayPal sandbox personal account (never a visitor's), the worker
# pays an approved demo caregiver payout through PayPal's sandbox to it: at most
# 500.00, one per demo circle, and KIN_DEMO_SANDBOX_PAYOUTS_PER_DAY (default 25)
# per UTC day. The web app reads the same line to say how the demo pays.
KIN_DEMO_SANDBOX_PAYEE_EMAIL=
KIN_DEMO_SANDBOX_PAYOUTS_PER_DAY=

# Claude on Amazon Bedrock (decisions 58 and 67). Unset turns off the features that read people's words.
# Credentials come from the AWS provider chain, such as AWS_PROFILE locally.
# These match the deployed app (infra/src/web-stack.ts): Claude Opus 4.6 through Bedrock Runtime's
# InvokeModel API, because Kin's AWS account is not served Claude Opus 5.5 on Bedrock's Messages
# endpoint ("mantle"). Use KIN_BEDROCK_API=mantle with KIN_BEDROCK_MODEL=anthropic.claude-opus-5-5
# only in an account that Bedrock serves that model.
KIN_BEDROCK_REGION=
KIN_BEDROCK_API=invoke
KIN_BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1

# Amazon Transcribe and Polly (decision 59). Unset turns Kin's listening and speaking off.
KIN_SPEECH_REGION=

# The demo pharmacy (decision 61). Unset, the worker simulates the seller in process.
# The service itself reads the KIN_MERCHANT_PAYPAL_* lines and charges nothing without them.
KIN_DEMO_MERCHANT_URL=
KIN_MERCHANT_PAYPAL_CLIENT_ID=
KIN_MERCHANT_PAYPAL_CLIENT_SECRET=
KIN_MERCHANT_PAYPAL_VAULT_ID=

# Kin's phone call to the parent after a caregiver's visit, and text messages with a check-in link.
# The worker places the call and needs all five; unset, the call loop does not start and messages
# stay queued. The voice service needs the same KIN_VOICE_PUBLIC_URL and KIN_VOICE_STATE_KEY.
# In AWS the voice service is the KinVoice stack on App Runner (decision 85), and nothing here is
# read by it: KIN_TWILIO_ACCOUNT_SID and KIN_TWILIO_AUTH_TOKEN are copied to Secrets Manager by
# `pnpm --filter @kin/infra run twilio:store`, the state key is generated there and never typed,
# and the public address and numbers are infra/cdk.json settings (kin:voicePublicUrl,
# kin:twilioCallerNumber) or, for the numbers, the same names as GitHub secrets. Below, fill
# them only to run the worker or the voice service on this machine.
# KIN_OFFICE_LINE_NUMBERS (the office line; unset, it answers every call "no record") is not listed.
KIN_TWILIO_ACCOUNT_SID=
KIN_TWILIO_AUTH_TOKEN=
KIN_TWILIO_CALLER_NUMBER=
KIN_VOICE_PUBLIC_URL=
KIN_VOICE_STATE_KEY=
# Texting a check-in link from the web app (apps/web/.env.example): the sender number, or a
# messaging service SID (MG...). In AWS it is kin:twilioSmsFrom or this name as a GitHub secret.
KIN_TWILIO_SMS_FROM=
# "Is it really you?" (decision 86). The worker texts a family member "is this you?" and a link to confirm their
# number when it has all four of KIN_TWILIO_ACCOUNT_SID, KIN_TWILIO_AUTH_TOKEN, KIN_TWILIO_SMS_FROM and the web
# app's public https address below (no path); unset, those messages stay queued and a check ends "could not be reached".
KIN_WEB_PUBLIC_URL=
# The number a parent rings to ask "is it really you?", served by the voice service: {"+1...": "<circle uuid>"} or
# {"+1...": {"circleId": "<uuid>", "locale": "fr"}}. A number of its own, never one of KIN_OFFICE_LINE_NUMBERS; unset, off.
KIN_PRESENCE_LINE_NUMBERS=
