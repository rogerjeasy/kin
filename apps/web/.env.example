# Sign-in settings for the web app (docs/tech-stack.md section 9). None of
# these is a secret: the app client is public and uses PKCE. Copy this file
# to .env.local and fill in the values from the deployed KinData stack.
#
# The token issuer: https://cognito-idp.<region>.amazonaws.com/<user pool id>
KIN_AUTH_ISSUER=
# The managed login domain: https://<prefix>.auth.<region>.amazoncognito.com
KIN_AUTH_LOGIN_URL=
# The "kin-web" app client ID.
KIN_AUTH_CLIENT_ID=
# This app's origin. It must be one of the callback origins registered on the
# app client (infra/cdk.json, kin:webOrigins): http://localhost:3000 in development.
KIN_WEB_ORIGIN=http://localhost:3000

# Kin's database, as the web app connects to it (packages/db). Locally, copy
# these from the root .env after `pnpm db:up` and `pnpm --filter @kin/db run migrate`.
# The web app holds only the person's role and, with the demo on, the demo
# provisioner. It never holds the admin or service passwords.
KIN_DATABASE_HOST=localhost
KIN_DATABASE_PORT=54329
KIN_DATABASE_NAME=kin
# "off" only for a database on this machine.
KIN_DATABASE_TLS=off
KIN_DATABASE_APP_PASSWORD=
KIN_DATABASE_PROVISIONER_PASSWORD=
# "on" makes the Demo button work: each visitor gets their own copy of Rose's
# circle, with no account. People who sign in never see the demo.
KIN_DEMO_CIRCLES=on
# Signs demo visitors' sessions. Any random text of at least 32 characters,
# for example from `openssl rand -base64 48`.
KIN_DEMO_SESSION_KEY=

# Top-ups: the pool's PayPal sandbox app and the queue to the worker, as in the
# root .env. Without them the "Add money" button is not shown.
KIN_PAYPAL_CLIENT_ID=
KIN_PAYPAL_CLIENT_SECRET=
KIN_QUEUE_ENDPOINT=http://localhost:9324
KIN_PAYPAL_INBOX_URL=http://localhost:9324/000000000000/kin-paypal-events.fifo
# Requests by PayPal invoice in demo circles: a PayPal sandbox personal account
# (…@personal.example.com only) that stands in for the demo's members, so a
# demo request is a real sandbox invoice. Unset, demo invoices are simulated
# and labelled so. Never a visitor's address.
KIN_DEMO_INVOICE_RECIPIENT_EMAIL=
# The same Kin sandbox account as the worker's, when demo caregiver payouts are paid
# through PayPal's sandbox. The page only says so; the worker pays. Unset: simulated.
KIN_DEMO_SANDBOX_PAYEE_EMAIL=

# Claude on Amazon Bedrock (decision 58). Unset turns off the features that read people's words.
# Credentials come from the AWS provider chain, such as AWS_PROFILE locally.
KIN_BEDROCK_REGION=
KIN_BEDROCK_API=mantle
KIN_BEDROCK_MODEL=anthropic.claude-opus-5-5

# Amazon Transcribe and Polly (decision 59). Unset turns Kin's listening and speaking off.
KIN_SPEECH_REGION=
